<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_joy_teleop</name>
  <version>0.1.0</version>
  <description>Gamepad teleoperation of the SO-101 arm: sensor_msgs/Joy (from the joy package) -> /joint_states, in joint or Cartesian mode. Drives RViz and, through lerobot_real, the real arm.</description>
  <maintainer email="kirupa_krishan@todo.todo">kirupa_krishan</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>arm_movement</exec_depend>
  <!-- lerobot_real is only needed for real:=true; placo only for Cartesian mode. -->
  <exec_depend>lerobot_real</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
